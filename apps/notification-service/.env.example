# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://notification:notification@localhost:5432/notification?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# Admin
ADMIN_API_KEY=dev-admin-key-change-me

# Mailhog (later)
EMAIL_ENABLED=true
SMTP_FROM=noreply@notification.local
SMTP_HOST=localhost
SMTP_PORT=1025

CLIENT_ORIGINS=http://localhost:5173